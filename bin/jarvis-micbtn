#!/bin/sh
# The dictation mic button (hold to dictate, drag to move). bin/jarvis-micbtn  |  bin/jarvis-micbtn stop
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
if [ "$1" = "stop" ]; then pkill -f "^\.venv/bin/python -m jarvis\.micbtn"; exit 0; fi
pgrep -f "^\.venv/bin/python -m jarvis\.micbtn" >/dev/null && exit 0
LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so exec .venv/bin/python -m jarvis.micbtn "$@"
