#!/bin/sh
# The Jarvis orb: a transparent circle on the overlay layer, above every window and on every workspace (see jarvis/orb.py).
#   bin/jarvis-orb         start it (one instance only)     bin/jarvis-orb stop    close it
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
if [ "$1" = "stop" ]; then pkill -f "^\.venv/bin/python -m jarvis\.orb"; exit 0; fi
pgrep -f "^\.venv/bin/python -m jarvis\.orb" >/dev/null && exit 0
LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so exec .venv/bin/python -m jarvis.orb "$@"
